[server]
# 仅用于本地开发。请替换为随机长字符串，不要提交真实值。
jwtSecret = "replace-with-a-random-local-secret"

[ai]
# 火山方舟 — 视觉模型（拍照识别食材）
apiKey = "replace-with-your-volcano-api-key"
baseURL = "https://ark.cn-beijing.volces.com/api/v3"
visionModel = "doubao-seed-2-1-pro-260628"

# DeepSeek 官方 — 文本模型（菜谱推荐/生成、运动推荐）
# 如果不配 DeepSeek，文本也会走火山方舟。两个 Key 填一个即可跑通。
textApiKey = "replace-with-your-deepseek-api-key"
textBaseURL = "https://api.deepseek.com/v1"
textModel = "deepseek-chat"

# 腾讯云等服务器部署时，也可以不创建本文件，改用以下环境变量：
# VOLCANO_ARK_API_KEY、VOLCANO_ARK_BASE_URL、VOLCANO_VISION_MODEL
# DEEPSEEK_API_KEY、DEEPSEEK_BASE_URL、DEEPSEEK_MODEL
# JWT_SECRET（生产环境必须设置为随机长字符串）
